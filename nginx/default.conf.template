# Site config, rendered at container start (envsubst): ${METUBE_URL} is the
# MeTube upstream, ${RETENTION_DAYS} feeds the "days left" hint in the UI,
# ${NGINX_LOCAL_RESOLVERS} comes from /etc/resolv.conf. Downloads are mounted
# at /downloads.

# CORS only for the extension (Firefox moz-extension://, Chromium
# chrome-extension://). With "*" the browser would discard the response when
# credentials:'include' is used.
map $http_origin $metube_ext_origin {
    default "";
    ~^moz-extension:// $http_origin;
    ~^chrome-extension:// $http_origin;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    # Web UI: same origin, MeTube's CORS guard sees same-origin.
    location /api/ {
        proxy_pass ${METUBE_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store" always;
    }

    # Extension: separate path, so the guard is not disabled for all pages.
    # No authentication in front of this path.
    location /ext/ {
        proxy_pass ${METUBE_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Sec-Fetch-Site none;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        add_header Access-Control-Allow-Origin $metube_ext_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Vary Origin always;
        add_header Cache-Control "no-store" always;
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # Language detection for "Text" in the web UI: the watch page of a
    # YouTube video, only for a valid 11-character ID, without cookies.
    # The extension fetches the page itself; the web page cannot because of CORS.
    location ~ "^/yt/([A-Za-z0-9_-]{11})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
        set $yt_id $1;
        proxy_pass https://www.youtube.com/watch?v=$yt_id;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host www.youtube.com;
        proxy_set_header Cookie "";
        proxy_set_header Accept-Encoding "";
        proxy_set_header Accept-Language "de-DE,de;q=0.9,en;q=0.8";
        proxy_set_header User-Agent "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36";
        proxy_hide_header Set-Cookie;
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
    }

    # File list as JSON, so the web UI can show per video which formats
    # (video, audio, text, thumbnail) already exist. Folders are read-only,
    # files can only be deleted (all formats of a video at once); downloads
    # still go through /api/download/. Hidden paths (.tmp) are blocked.
    # Order matters: nginx takes the first matching regex.
    location ~ "^/files/(.*/)?\." {
        return 404;
    }
    location ~ "^/files/(.*[^/])$" {
        alias /downloads/$1;
        dav_methods DELETE;
        disable_symlinks on;
        limit_except DELETE { deny all; }
    }
    location /files/ {
        alias /downloads/;
        autoindex on;
        disable_symlinks on;
        autoindex_format json;
        limit_except GET { deny all; }
        add_header Cache-Control "no-store" always;
    }

    # Settings for the web UI.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 "window.COMPANION = { keepDays: ${RETENTION_DAYS} };\n";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
