# Site config, rendered at container start (envsubst): ${METUBE_UPSTREAM}
# (host:port from METUBE_URL, see docker/16-metube-upstream.envsh) is MeTube, ${RETENTION_DAYS} feeds the "days left" hint in the UI,
# ${NGINX_LOCAL_RESOLVERS} comes from /etc/resolv.conf, ${COMPANION_TOKEN}
# (optional) protects everything that touches MeTube or files. Downloads are
# mounted at /downloads.

# CORS only for the extension (Firefox moz-extension://, Chromium
# chrome-extension://). With "*" the browser would discard the response when
# credentials:'include' is used.
map $http_origin $metube_ext_origin {
    default "";
    ~^moz-extension:// $http_origin;
    ~^chrome-extension:// $http_origin;
}

# Optional access token: sent by the extension as X-Companion-Token, by the
# web UI as cookie companion_token. Empty COMPANION_TOKEN = no check.
map "${COMPANION_TOKEN}" $auth_on {
    "" 0;
    default 1;
}
map $http_x_companion_token $token_header {
    default 0;
    "${COMPANION_TOKEN}" 1;
}
map $cookie_companion_token $token_cookie {
    default 0;
    "${COMPANION_TOKEN}" 1;
}
map "$auth_on$token_header$token_cookie" $auth_ok {
    ~^0 1;
    ~^1(1.|.1)$ 1;
    default 0;
}

# MeTube is re-resolved every 10 s, so a recreated MeTube container with a new
# IP keeps working without restarting the companion.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
upstream metube {
    zone metube 64k;
    server ${METUBE_UPSTREAM} resolve;
}

# Only real extension requests may pass MeTube's cross-origin guard; any other
# origin keeps the browser's own Sec-Fetch-Site, so other web pages cannot use
# /ext/ to start downloads, delete files or upload cookies (CSRF).
map $http_origin $ext_sec_fetch_site {
    ~^(moz|chrome)-extension:// none;
    default $http_sec_fetch_site;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    # Web UI: same origin, MeTube's CORS guard sees same-origin.
    location /api/ {
        if ($auth_ok = 0) {
            return 401;
        }
        proxy_pass http://metube/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store" always;
        # Downloaded files (e.g. .html, .svg) must never run as part of this site.
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
        # The UI polls the history every 2 s; keep the log readable.
        access_log off;
    }

    # Extension: separate path, so the guard is not disabled for all pages.
    # MeTube's live updates are not needed by the extension; blocking them keeps
    # other web pages from reading the history through this path.
    location ^~ /ext/socket.io {
        return 404;
    }

    location /ext/ {
        proxy_pass http://metube/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Sec-Fetch-Site $ext_sec_fetch_site;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        add_header Access-Control-Allow-Origin $metube_ext_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Headers "Content-Type, X-Companion-Token" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Vary Origin always;
        add_header Cache-Control "no-store" always;
        # Downloaded files (e.g. .html, .svg) must never run as part of this site.
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        if ($request_method = OPTIONS) {
            return 204;
        }
        if ($auth_ok = 0) {
            return 401;
        }
    }

    # Language detection for "Text" in the web UI: the watch page of a
    # YouTube video, only for a valid 11-character ID, without cookies.
    # The extension fetches the page itself; the web page cannot because of CORS.
    location ~ "^/yt/([A-Za-z0-9_-]{11})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
        set $yt_id $1;
        if ($auth_ok = 0) {
            return 401;
        }
        proxy_pass https://www.youtube.com/watch?v=$yt_id;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host www.youtube.com;
        proxy_set_header Cookie "";
        proxy_set_header Accept-Encoding "";
        proxy_set_header Accept-Language "de-DE,de;q=0.9,en;q=0.8";
        proxy_set_header User-Agent "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36";
        proxy_hide_header Set-Cookie;
        # Only read as text by the UI; never render YouTube's page on this origin.
        proxy_hide_header Content-Type;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Type "text/plain; charset=utf-8" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
    }

    # File list as JSON, so the web UI can show per video which formats
    # (video, audio, text, thumbnail) already exist. Folders are read-only,
    # files can only be deleted (all formats of a video at once); downloads
    # still go through /api/download/. Hidden paths (.tmp) are blocked.
    # Order matters: nginx takes the first matching regex.
    location ~ "^/files/(.*/)?\." {
        return 404;
    }
    # Named capture: the token check below evaluates a regex map, which
    # would overwrite $1 and turn the path into the whole folder.
    location ~ "^/files/(?<file>.*[^/])$" {
        alias /downloads/$file;
        if ($auth_ok = 0) {
            return 401;
        }
        dav_methods DELETE;
        disable_symlinks on;
        limit_except DELETE { deny all; }
    }
    location /files/ {
        alias /downloads/;
        if ($auth_ok = 0) {
            return 401;
        }
        autoindex on;
        disable_symlinks on;
        autoindex_format json;
        access_log off;
        limit_except GET { deny all; }
        add_header Cache-Control "no-store" always;
    }

    # Settings for the web UI.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 "window.COMPANION = { keepDays: ${RETENTION_DAYS}, authRequired: $auth_on };\n";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
