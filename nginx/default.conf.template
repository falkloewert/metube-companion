# Site config, rendered at container start (envsubst): ${METUBE_UPSTREAM}
# (host:port from METUBE_URL, see docker/16-metube-upstream.envsh) is MeTube, ${RETENTION_DAYS} and ${TRASH_DAYS} feed the "days left" hints in the UI,
# ${NGINX_LOCAL_RESOLVERS} comes from /etc/resolv.conf, ${COMPANION_TOKEN}
# (optional) protects everything that touches MeTube or files,
# ${YOUTUBE_WATCH_URL} is YouTube's watch page (a mock in the factory sandbox).
# Downloads are mounted at /downloads.

# CORS only for the extension (Firefox moz-extension://, Chromium
# chrome-extension://). With "*" the browser would discard the response when
# credentials:'include' is used.
map $http_origin $metube_ext_origin {
    default "";
    ~^moz-extension:// $http_origin;
    ~^chrome-extension:// $http_origin;
}

# CORS for the extension's reads of /files/ and /yt/ (Firefox applies CORS
# to extension pages). Every value is empty for other origins, so they get no
# CORS headers at all; only GET is allowed (no Allow-Methods), never MOVE or
# DELETE.
map $metube_ext_origin $ext_cors_credentials {
    "" "";
    default "true";
}
map $metube_ext_origin $ext_cors_headers {
    "" "";
    default "X-Companion-Token";
}
map "$request_method:$metube_ext_origin" $ext_preflight {
    "~^OPTIONS:." 1;
    default "";
}

# Optional access token: sent by the extension as X-Companion-Token, by the
# web UI as cookie companion_token. Empty COMPANION_TOKEN = no check.
map "${COMPANION_TOKEN}" $auth_on {
    "" 0;
    default 1;
}
map $http_x_companion_token $token_header {
    default 0;
    "${COMPANION_TOKEN}" 1;
}
map $cookie_companion_token $token_cookie {
    default 0;
    "${COMPANION_TOKEN}" 1;
}
map "$auth_on$token_header$token_cookie" $auth_ok {
    ~^0 1;
    ~^1(1.|.1)$ 1;
    default 0;
}

# MeTube is re-resolved every 10 s, so a recreated MeTube container with a new
# IP keeps working without restarting the companion.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
upstream metube {
    zone metube 64k;
    server ${METUBE_UPSTREAM} resolve;
}

# Only real extension requests may pass MeTube's cross-origin guard; any other
# origin keeps the browser's own Sec-Fetch-Site, so other web pages cannot use
# /ext/ to start downloads, delete files or upload cookies (CSRF).
map $http_origin $ext_sec_fetch_site {
    ~^(moz|chrome)-extension:// none;
    default $http_sec_fetch_site;
}

# Rules for /files/ (the file list and the trash). Everything is decided here,
# before nginx's WebDAV module acts:
#   $files_src   what the request path is: dir, plain (visible file), trash
#                (file in /.trash/<unix time>/), hide (any other hidden path)
#   $files_dest  the same for the Destination header of MOVE; "bad" if it is
#                not a clean path (no hidden segment, no encoded dot, slash
#                or backslash, no query)
#   $files_rule  "" = allowed, deny = 403, hide = 404
# Allowed: list folders, DELETE a file, MOVE a file visible -> trash or trash
# -> visible with "Overwrite: F" (an existing file is never replaced, 412).
# Folders cannot be moved or deleted, files are never served from here.
map $uri $files_src {
    "~^/files/\.trash/[0-9]{9,11}/(?:[^/.][^/]*/)*[^/.][^/]*$" trash;
    "~^/files/(?:[^/.][^/]*/)*[^/.][^/]*$" plain;
    "~^/files/(?:\.trash/(?:[0-9]{9,11}/)?)?(?:[^/.][^/]*/)*$" dir;
    default hide;
}
map $http_destination $files_dest {
    "~^(?:https?://[^/?#]+)?/files/\.trash/[0-9]{9,11}/(?:(?:[^/.%?#]|%(?!2[eEfF]|5[cC]|00))(?:[^/%?#]|%(?!2[eEfF]|5[cC]|00))*/)*(?:[^/.%?#]|%(?!2[eEfF]|5[cC]|00))(?:[^/%?#]|%(?!2[eEfF]|5[cC]|00))*$" trash;
    "~^(?:https?://[^/?#]+)?/files/(?:(?:[^/.%?#]|%(?!2[eEfF]|5[cC]|00))(?:[^/%?#]|%(?!2[eEfF]|5[cC]|00))*/)*(?:[^/.%?#]|%(?!2[eEfF]|5[cC]|00))(?:[^/%?#]|%(?!2[eEfF]|5[cC]|00))*$" plain;
    default bad;
}
map "$request_method:$files_src:$files_dest:$http_overwrite" $files_rule {
    "~^[A-Z]+:hide:" hide;
    "~^(GET|HEAD):dir:" "";
    "~^DELETE:(plain|trash):" "";
    "~^MOVE:plain:trash:F$" "";
    "~^MOVE:trash:plain:F$" "";
    default deny;
}
# Folder listings are polled; keep the log readable.
map $request_method $files_log {
    GET 0;
    HEAD 0;
    default 1;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    # Web UI: same origin, MeTube's CORS guard sees same-origin.
    location /api/ {
        if ($auth_ok = 0) {
            return 401;
        }
        proxy_pass http://metube/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store" always;
        # Downloaded files (e.g. .html, .svg) must never run as part of this site.
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
        # The UI polls the history every 2 s; keep the log readable.
        access_log off;
    }

    # Extension: separate path, so the guard is not disabled for all pages.
    # MeTube's live updates are not needed by the extension; blocking them keeps
    # other web pages from reading the history through this path.
    location ^~ /ext/socket.io {
        return 404;
    }

    location /ext/ {
        proxy_pass http://metube/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Sec-Fetch-Site $ext_sec_fetch_site;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        add_header Access-Control-Allow-Origin $metube_ext_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Access-Control-Allow-Headers "Content-Type, X-Companion-Token" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Vary Origin always;
        add_header Cache-Control "no-store" always;
        # Downloaded files (e.g. .html, .svg) must never run as part of this site.
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
        if ($request_method = OPTIONS) {
            return 204;
        }
        if ($auth_ok = 0) {
            return 401;
        }
    }

    # Language detection for "Text": the watch page of a YouTube video, only
    # for a valid 11-character ID, without cookies. The web UI uses /yt/, the
    # extension /ext/yt/ (behind a login proxy only /ext/ and /files/ are open).
    location ~ "^/(?:ext/)?yt/([A-Za-z0-9_-]{11})$" {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
        set $yt_id $1;
        add_header Access-Control-Allow-Origin $metube_ext_origin always;
        add_header Access-Control-Allow-Credentials $ext_cors_credentials always;
        add_header Access-Control-Allow-Headers $ext_cors_headers always;
        add_header Vary Origin always;
        if ($ext_preflight) {
            return 204;
        }
        if ($auth_ok = 0) {
            return 401;
        }
        proxy_pass ${YOUTUBE_WATCH_URL}$yt_id;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host www.youtube.com;
        proxy_set_header Cookie "";
        proxy_set_header Accept-Encoding "";
        proxy_set_header Accept-Language "de-DE,de;q=0.9,en;q=0.8";
        proxy_set_header User-Agent "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36";
        proxy_hide_header Set-Cookie;
        # Only read as text by the UI; never render YouTube's page on this origin.
        proxy_hide_header Content-Type;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Type "text/plain; charset=utf-8" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
    }

    # File list as JSON, so the web UI can show per video which formats
    # (video, audio, text, thumbnail) already exist. Folders are read-only;
    # files can only be deleted or moved into / out of the trash
    # (/downloads/.trash/<unix time>/<path>, see $files_rule above); downloads
    # still go through /api/download/. Hidden paths other than the trash
    # (.tmp, .metube) are blocked. CORS only lets the extension read the
    # listing (see $ext_preflight), so other web pages cannot use this path.
    # A prefix location with a plain alias is required: nginx maps the
    # Destination header of MOVE with the config of the location, a regex
    # alias would resolve it to the source path again.
    location ^~ /files/ {
        alias /downloads/;
        add_header Access-Control-Allow-Origin $metube_ext_origin always;
        add_header Access-Control-Allow-Credentials $ext_cors_credentials always;
        add_header Access-Control-Allow-Headers $ext_cors_headers always;
        add_header Vary Origin always;
        if ($ext_preflight) {
            return 204;
        }
        if ($auth_ok = 0) {
            return 401;
        }
        if ($files_rule = hide) {
            return 404;
        }
        if ($files_rule = deny) {
            return 403;
        }
        dav_methods DELETE MOVE;
        create_full_put_path on;
        # Honoured by DELETE and reads, NOT by MOVE (checked): a symlink in
        # the download folder could be followed. Planting one needs write
        # access to that folder; accepted.
        disable_symlinks on;
        # Never serve a folder's index.html (the server-level "index" would):
        # a hidden name cannot exist as a movable file, and the internal
        # redirect to it hits the "hide" rule (404), so autoindex answers.
        index .no-index;
        autoindex on;
        autoindex_format json;
        # Anything but the autoindex JSON must never run as a page on this
        # origin, even if a file slips through some other way.
        types {}
        default_type application/octet-stream;
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log /dev/stdout combined if=$files_log;
        add_header Cache-Control "no-store" always;
    }

    # Settings for the web UI.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        return 200 "window.COMPANION = { keepDays: ${RETENTION_DAYS}, trashDays: ${TRASH_DAYS}, authRequired: $auth_on };\n";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
