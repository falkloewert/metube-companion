{
  "manifest_version": 3,
  "name": "MeTube Companion",
  "version": "0.4.1",
  "description": "Sends the current link, optionally with that site's cookies, to your own MeTube instance.",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to MeTube",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*"
  ],
  "optional_permissions": [
    "cookies"
  ]
}
