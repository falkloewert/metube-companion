{
  "manifest_version": 3,
  "name": "MeTube Companion",
  "version": "0.1.0",
  "description": "Sends the current link with matching cookies to your own MeTube instance.",
  "permissions": [
    "cookies",
    "storage",
    "downloads",
    "alarms",
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8081/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to MeTube",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
