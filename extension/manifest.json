{
  "manifest_version": 2,
  "name": "MeTube Companion",
  "version": "0.5.0",
  "description": "Sends the current link, optionally with that site's cookies, to your own MeTube instance.",
  "browser_specific_settings": {
    "gecko": {
      "id": "metube-companion@falkloewert",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ],
        "optional": [
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "background": {
    "scripts": [
      "compat.js",
      "shared.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Send to MeTube",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_permissions": [
    "cookies",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*"
  ]
}
